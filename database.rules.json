{
  "rules": {
    ".read": false,
    ".write": false,
    "pads": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z2-9]{5}$/)",
        "host": { ".validate": "newData.isNumber()" },
        "pad": { ".validate": "newData.isBoolean()" },
        "input": {
          "x": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1" },
          "y": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1" },
          "a": { ".validate": "newData.isNumber()" },
          "b": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}

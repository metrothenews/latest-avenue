rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// The UID below is the same as ownerUid in src/data/firebase.js (metrothenews@gmail.com).
// The owner can read and write everything. Team members (people listed in teamMembers, managed
// at /admin/team) can read the team list and the portal's content, and use team messaging.
// Everyone else, signed in or not, is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'cUUEuJ7NRCZVuMNhSxOr7yzA8DX2';
    }
    function myEmail() {
      return request.auth.token.email;
    }
    function onTeam(email) {
      return exists(/databases/$(database)/documents/teamMembers/$(email));
    }
    // On the team: signed in with a verified email that has a teamMembers document.
    function isTeam() {
      return request.auth != null && request.auth.token.email_verified == true && onTeam(myEmail());
    }

    // On the crew list (crew/{email}, managed in the Crew section of /admin/team).
    function isCrew() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/crew/$(myEmail()));
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }

    // teamMembers/{email}: one document per person, keyed by their lowercase Google email.
    // Anyone signed in can check their own; team members can see who else is on the team.
    // Anyone can also sign themselves up at /team/join: they may create their own entry (their
    // own verified email, a name and a role, marked `signedUp`), once, unless the owner has
    // blocked that email. They can't change it afterwards or mark themselves as the owner.
    match /teamMembers/{email} {
      allow create: if request.auth != null && request.auth.token.email_verified == true && myEmail() == email
        && !exists(/databases/$(database)/documents/teamBlocked/$(email))
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'addedAt', 'signedUp'])
        && request.resource.data.email == email && request.resource.data.signedUp == true
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.role is string && request.resource.data.role.size() <= 80
        && request.resource.data.addedAt is string && request.resource.data.addedAt.size() <= 40;
      allow get: if request.auth != null && request.auth.token.email_verified == true && myEmail() == email;
      allow read: if isTeam();
    }

    // crew/{email}: one person on a project, keyed by their lowercase Google email. They can read
    // their own entry (it holds their phone number, so nobody else's); only the owner writes or lists.
    match /crew/{email} {
      allow get: if request.auth != null && request.auth.token.email_verified == true && myEmail() == email;
    }

    // teamBlocked/{email}: emails the owner has removed for good, so they can't sign up again.
    // Each person can see whether their own is on it; only the owner writes or lists.
    match /teamBlocked/{email} {
      allow get: if request.auth != null && request.auth.token.email_verified == true && myEmail() == email;
    }

    // portal/{doc}: what the team portal shows (e.g. portal/welcome).
    match /portal/{doc} {
      allow get: if isTeam();
    }

    // assignments/{key}: one assignment from the backlog doc (managed at /admin/team). A team member
    // can read only the ones assigned to them; unassigned ones (the backlog) are owner-only.
    // adminSettings/{doc} stays owner-only (covered by the rule above).
    match /assignments/{key} {
      allow read: if isTeam() && myEmail() in resource.data.assignees;
    }

    // latest avenue note (/team/note). Team members read and write every board and card. The crew
    // read every board, card and file, and never write. Anyone,
    // signed in or not, can read a board whose `public` is true (its read-only link, set from
    // Share) and that board's cards; they can never write.
    match /noteBoards/{boardId} {
      allow read: if isTeam() || isCrew() || resource.data.public == true;
      allow write: if isTeam();

      match /cards/{cardId} {
        allow read: if isTeam() || isCrew() || get(/databases/$(database)/documents/noteBoards/$(boardId)).data.public == true;
        allow write: if isTeam();
      }
    }

    // Files on note boards (PDFs), stored as text in parts. A file can be read by whoever can read
    // the board its card is on (`board`): team members, or anyone if that board is public.
    match /noteFiles/{fileId} {
      function boardIsPublic(board) {
        return get(/databases/$(database)/documents/noteBoards/$(board)).data.public == true;
      }
      allow read: if isTeam() || isCrew() || boardIsPublic(resource.data.board);
      allow write: if isTeam();

      match /parts/{part} {
        allow read: if isTeam() || isCrew() || boardIsPublic(get(/databases/$(database)/documents/noteFiles/$(fileId)).data.board);
        allow write: if isTeam();
      }
    }

    // Team messaging. chats/team is the shared chat; chats/{a}|{b} is a private conversation
    // between two team members (emails in alphabetical order, also stored in `members`).
    // A chat document only holds who is in it and when the last message was sent.
    match /chats/{chatId} {
      function stamped() {
        return request.resource.data.lastFrom == myEmail() && request.resource.data.lastAt == request.time;
      }
      function validPair() {
        let members = request.resource.data.members;
        return members is list && members.size() == 2 && members[0] < members[1]
          && chatId == members[0] + '|' + members[1]
          && myEmail() in members && onTeam(members[0]) && onTeam(members[1]);
      }

      allow get: if isTeam() && (chatId == 'team' || myEmail() in resource.data.members);
      allow list: if isTeam() && myEmail() in resource.data.members;
      allow create: if isTeam() && stamped() && (
        (chatId == 'team' && request.resource.data.keys().hasOnly(['lastAt', 'lastFrom']))
        || (chatId != 'team' && request.resource.data.keys().hasOnly(['members', 'lastAt', 'lastFrom']) && validPair())
      );
      allow update: if isTeam() && stamped()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastFrom'])
        && (chatId == 'team' || myEmail() in resource.data.members);

      // Messages can be added and read by the people in the chat, never edited or deleted by them.
      match /messages/{messageId} {
        allow read: if isTeam() && (chatId == 'team'
          || myEmail() in get(/databases/$(database)/documents/chats/$(chatId)).data.members);
        // getAfter: a first message is written together with its chat document.
        allow create: if isTeam() && (chatId == 'team'
            || myEmail() in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members)
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.from == myEmail()
          && request.resource.data.at == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000;
      }
    }
  }
}

rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// The UID below is the same as ownerUid in src/data/firebase.js (metrothenews@gmail.com).
// Only you can read or write anything; everyone else, signed in or not, is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == 'cUUEuJ7NRCZVuMNhSxOr7yzA8DX2';
    }
  }
}

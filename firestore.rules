rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Replace OWNER_UID with your user ID (the same value as ownerUid in src/data/firebase.js).
// Only you can read or write anything; everyone else, signed in or not, is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == 'OWNER_UID';
    }
  }
}
